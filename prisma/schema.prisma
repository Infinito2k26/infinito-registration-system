generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Outcome of a gate scan: ENTERED = the action succeeded (check-in or check-out), REJECTED = refused.
enum EntryStatus {
  ENTERED
  REJECTED
}

enum EntryKind {
  CHECK_IN
  CHECK_OUT
}

enum EmailBatchKind {
  /// Every eligible student of a college gets their own QR at their own email.
  COLLEGE_EACH
  /// All eligible students' QR passes in one email to one selected student.
  COLLEGE_TO_ONE
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

/// What Resend reported after the email left us (via its webhook).
enum EmailDeliveryStatus {
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
}

enum StaffRole {
  /// Everything coordinators can do, plus managing staff accounts.
  ADMIN
  /// Registrations, payment verification, QR emails, entry information.
  COORDINATOR
  /// Gate only: scan QR, see entry details, mark entered.
  VOLUNTEER
}

enum ActivityType {
  SUBMITTED
  UPDATED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYMENT_UNVERIFIED
  QR_EMAIL_QUEUED
  QR_EMAIL_RESENT
  ENTERED
  ENTRY_DENIED
  EMAIL_CHANGED
  QR_EMAIL_BULK_QUEUED
  QR_PASSES_FORWARDED
  CHECKED_OUT
  CHECKOUT_DENIED
  BLOCKED
  UNBLOCKED
}

model Person {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Current (resolved) email: stored lowercased and trimmed; one person = one QR across all
  /// events. Optional: a participant without a usable email is still registered, verified and
  /// gets a QR token; emails are queued only once an address exists (see ParticipantsService).
  /// Also unique case-insensitively: index "Person_email_lower_key" on lower(email), created in
  /// migration 20261007090000 (Prisma cannot express expression indexes here).
  email                String?   @unique
  /// "<responseId>#<member position>" for a participant first created WITHOUT an email, so a
  /// resync of that form row finds the same person instead of creating a duplicate.
  sourceKey            String?   @unique
  name                 String?
  phone                String?
  /// College name as last submitted (display); grouping uses collegeId.
  college              String?
  collegeId            String?   @db.Uuid
  rollNumber           String?
  /// Only the last 4 Aadhaar digits are stored; the full number never enters this database.
  aadhaarLast4         String?
  /// Full Aadhaar number, AES-256-GCM encrypted with AADHAAR_ENCRYPTION_KEY ("v1:iv:tag:data").
  /// Decrypted only to render an ADMIN's page; never sent to coordinators/volunteers.
  aadhaarEncrypted     String?
  /// Aadhaar card image (Drive file ID). ADMIN only.
  aadhaarDriveId       String?
  /// Aadhaar-based participant profile (full Aadhaar identity). Several Person records (e.g.
  /// different emails) with the same full Aadhaar share one profile; null = no full Aadhaar.
  participantProfileId String?   @db.Uuid
  /// Gate access block (whole participant, every event). History lives in RegistrationActivity.
  blockedAt            DateTime?
  blockedById          String?   @db.Uuid
  blockReason          String?
  /// Google Drive file IDs. Files stay private; the server proxies them to logged-in volunteers.
  photoDriveId         String?
  idDocumentDriveId    String?
  /// Random bearer token encoded in the QR URL (/p/<qrToken>). Created on the person's first verified
  /// payment; kept in plain form so passes can be re-sent.
  qrToken              String?   @unique

  /// Migration of past participants: token embedded in the pre-filled profile form link.
  profileToken          String?   @unique
  profileCompletedAt    DateTime?
  profileReminderCount  Int       @default(0)
  profileLastRemindedAt DateTime?

  /// Set from Resend bounce/complaint webhooks.
  emailBouncedAt    DateTime?
  emailBounceReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers        TeamMember[]
  registrations      Registration[]
  entryLogs          EntryLog[]
  emailOutbox        EmailOutbox[]
  collegeRef         College?            @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  emailAliases       PersonEmailAlias[]
  participantProfile ParticipantProfile? @relation(fields: [participantProfileId], references: [id], onDelete: SetNull)
  batchesReceived    EmailBatch[]
  blockedBy          StaffUser?          @relation("PersonBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  @@index([profileCompletedAt])
  @@index([collegeId])
  @@index([blockedAt])
  @@index([phone])
  @@index([rollNumber])
  @@index([participantProfileId])
}

/// Colleges as submitted, grouped by a normalised key (lowercase, single spaces).
model College {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameKey   String   @unique
  createdAt DateTime @default(now())

  people  Person[]
  batches EmailBatch[]
}

/// Previous emails of a person (after a staff email change). Form resyncs that still carry
/// the old email resolve to the same person instead of recreating it.
model PersonEmailAlias {
  email     String   @id
  personId  String   @db.Uuid
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Team {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  eventSlug    String
  captainEmail String?
  /// Google Form response ID the team was created from; makes webhook retries and resyncs idempotent.
  responseId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       TeamMember[]
  registrations Registration[]

  @@unique([eventSlug, responseId])
  @@index([eventSlug])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  personId  String   @db.Uuid
  role      String?
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
  @@index([personId])
}

model Registration {
  id                    String             @id @default(uuid()) @db.Uuid
  eventSlug             String
  personId              String             @db.Uuid
  teamId                String?            @db.Uuid
  transactionId         String?
  paymentStatus         PaymentStatus      @default(PENDING)
  status                RegistrationStatus @default(PENDING)
  /// Rejection reason shown to coordinators and sent to the captain.
  paymentRemarks        String?
  /// Last verify/reject decision. Full history lives in RegistrationActivity.
  paymentReviewedById   String?            @db.Uuid
  paymentReviewedAt     DateTime?
  sourceForm            String?
  sourceSheet           String?
  sourceRow             Int?
  responseId            String?
  /// Gate entry. Set once with a conditional update (where enteredAt is null), so two simultaneous scans cannot both succeed.
  enteredAt             DateTime?
  enteredById           String?            @db.Uuid
  /// Current presence: set on check-in, cleared on check-out (conditional updates, race-safe).
  insideSince           DateTime?
  lastCheckInAt         DateTime?
  lastCheckOutAt        DateTime?
  /// Form details (per event registration). Accommodation dates are not gate check-in/out.
  accommodation         String?
  accommodationPeriod   String?
  /// Form "Check In Date" / "Check Out Date": the participant's PLANNED arrival/departure, as
  /// submitted (text) and parsed (date). Never the actual gate time (see insideSince / EntryLog).
  expectedArrivalText   String?
  expectedDepartureText String?
  expectedArrivalDate   DateTime?          @db.Date
  expectedDepartureDate DateTime?          @db.Date
  remark                String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  person            Person                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  team              Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  enteredBy         StaffUser?              @relation("RegistrationEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  paymentReviewedBy StaffUser?              @relation("RegistrationReviewedBy", fields: [paymentReviewedById], references: [id], onDelete: SetNull)
  activities        RegistrationActivity[]
  verificationItems VerificationBatchItem[]
  emails            EmailOutbox[]
  entryLogs         EntryLog[]

  /// One registration per person per event; re-ingesting the same response updates it.
  @@unique([eventSlug, personId])
  @@index([eventSlug, paymentStatus])
  @@index([insideSince])
  /// "Ever entered" list: enteredAt is the first successful gate check-in, never cleared.
  @@index([enteredAt])
  @@index([expectedArrivalDate])
  @@index([expectedDepartureDate])
  @@index([transactionId])
  @@index([teamId])
}

/// Append-only history of everything that happened to a registration.
model RegistrationActivity {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  type           ActivityType
  /// Null for system actions (form sync, email worker).
  actorId        String?      @db.Uuid
  details        Json?
  createdAt      DateTime     @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        StaffUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([registrationId, createdAt])
}

/// Every scan outcome at the gate, successful or not.
model EntryLog {
  id             String      @id @default(uuid()) @db.Uuid
  personId       String      @db.Uuid
  registrationId String?     @db.Uuid
  eventSlug      String
  volunteerId    String?     @db.Uuid
  kind           EntryKind   @default(CHECK_IN)
  status         EntryStatus @default(ENTERED)
  enteredAt      DateTime    @default(now())
  gate           String?
  notes          String?

  person       Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  volunteer    StaffUser?    @relation(fields: [volunteerId], references: [id], onDelete: SetNull)

  @@index([personId, eventSlug])
  @@index([eventSlug, enteredAt])
  @@index([registrationId])
}

model StaffUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String?
  role           StaffRole @default(VOLUNTEER)
  /// Pending magic-link login; single use, cleared on sign-in.
  magicTokenHash String?   @unique
  tokenExpiry    DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entryLogs             EntryLog[]
  sessions              StaffSession[]
  enteredRegistrations  Registration[]         @relation("RegistrationEnteredBy")
  reviewedRegistrations Registration[]         @relation("RegistrationReviewedBy")
  activities            RegistrationActivity[]
  triggeredEmails       EmailOutbox[]
  emailBatches          EmailBatch[]
  verificationBatches   VerificationBatch[]
  settingsUpdated       SystemSetting[]
  registrationDeletions RegistrationDeletion[]
  blockedPeople         Person[]               @relation("PersonBlockedBy")
}

/// One row per signed-in device, so staff can be signed in on several phones.
model StaffSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
}

model EmailOutbox {
  id                String               @id @default(uuid()) @db.Uuid
  personId          String?              @db.Uuid
  /// Set for participant emails about a specific registration (QR pass, payment issue).
  registrationId    String?              @db.Uuid
  /// Staff member whose action queued this email (verify, resend); null for automatic emails.
  triggeredById     String?              @db.Uuid
  /// Bulk college send this email belongs to.
  batchId           String?              @db.Uuid
  toEmail           String
  /// e.g. "qr-pass:<registrationId>:initial". Enqueueing the same key twice is a no-op; also sent to Resend as its Idempotency-Key.
  idempotencyKey    String               @unique
  subject           String
  template          String?
  payload           Json?
  status            EmailStatus          @default(PENDING)
  attempts          Int                  @default(0)
  sendAt            DateTime             @default(now())
  sentAt            DateTime?
  /// Resend email ID, used to match delivery webhooks back to the row.
  providerMessageId String?              @unique
  deliveryStatus    EmailDeliveryStatus?
  deliveryUpdatedAt DateTime?
  lastError         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  person            Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  registration      Registration?           @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  triggeredBy       StaffUser?              @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  batch             EmailBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  verificationItems VerificationBatchItem[]

  @@index([status, sendAt])
  @@index([batchId])
  @@index([registrationId, template])
}

/// Audit record of a bulk college QR send; per-email progress comes from its EmailOutbox rows.
model EmailBatch {
  id                String         @id @default(uuid()) @db.Uuid
  kind              EmailBatchKind
  collegeId         String         @db.Uuid
  /// Null = all events of the college.
  eventSlug         String?
  /// COLLEGE_TO_ONE: the selected student and the address used at the time.
  recipientPersonId String?        @db.Uuid
  recipientEmail    String?
  triggeredById     String?        @db.Uuid
  eligibleCount     Int
  queuedCount       Int
  createdAt         DateTime       @default(now())

  college         College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  recipientPerson Person?       @relation(fields: [recipientPersonId], references: [id], onDelete: SetNull)
  triggeredBy     StaffUser?    @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  emails          EmailOutbox[]

  @@index([collegeId, createdAt])
}

enum VerificationBatchOutcome {
  VERIFIED
  SKIPPED
  FAILED
}

/// One admin "Verify Selected" run. Every registration in it went through the normal Verify
/// (PaymentsService.verifyTeam); the counts are a snapshot at the end of the run. Email
/// progress (sent / failed / pending) is read live from the linked EmailOutbox rows.
model VerificationBatch {
  id             String   @id @default(uuid()) @db.Uuid
  triggeredById  String?  @db.Uuid
  selectedCount  Int
  verifiedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  failedCount    Int      @default(0)
  qrEmailsQueued Int      @default(0)
  noEmailCount   Int      @default(0)
  createdAt      DateTime @default(now())

  triggeredBy StaffUser?              @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  items       VerificationBatchItem[]

  @@index([createdAt])
}

/// One registration in a bulk run: a selected one (VERIFIED / SKIPPED / FAILED with reason) or a
/// teammate verified with it (same form response, as the individual Verify does).
model VerificationBatchItem {
  id             String                   @id @default(uuid()) @db.Uuid
  batchId        String                   @db.Uuid
  registrationId String?                  @db.Uuid
  /// Snapshot when verified, so the report keeps showing who it was.
  personName     String?
  /// Address the QR email was queued to; null = the participant had no email.
  email          String?
  eventSlug      String
  selected       Boolean                  @default(true)
  outcome        VerificationBatchOutcome
  reason         String?
  /// The automatic QR pass email (same row as an individual Verify queues).
  emailOutboxId  String?                  @db.Uuid
  createdAt      DateTime                 @default(now())

  batch        VerificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  registration Registration?     @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  emailOutbox  EmailOutbox?      @relation(fields: [emailOutboxId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([registrationId])
}

/// Admin-changeable settings. Never secrets: credentials stay in .env. Currently one key:
/// "email.provider" = "smtp" | "resend" (overrides EMAIL_PROVIDER once an admin saves it).
model SystemSetting {
  key         String   @id
  value       String
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy StaffUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// ONE FULL AADHAAR = ONE PARTICIPANT PROFILE (one physical participant). Groups the Person
/// records (and through them every Registration, QR token and email) that share a full Aadhaar.
/// The number itself is never stored here in plain text.
model ParticipantProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  /// HMAC-SHA256 of the normalised 12 digits with a key derived from AADHAAR_ENCRYPTION_KEY.
  /// Deterministic, so equal numbers match; unique, so two profiles can never share a number.
  aadhaarFingerprint String   @unique
  aadhaarLast4       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  people Person[]

  @@index([aadhaarLast4])
}

/// Audit record of a registration an admin deleted (Duplicate Aadhaar Check). Its gate logs and
/// emails are kept (unlinked); a resync of the same form row does not recreate it.
model RegistrationDeletion {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @db.Uuid
  personId       String   @db.Uuid
  eventSlug      String
  responseId     String?
  deletedById    String?  @db.Uuid
  /// What was deleted: registration fields, participant name/email, its activity history.
  snapshot       Json
  deletedAt      DateTime @default(now())

  deletedBy StaffUser? @relation(fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([responseId, eventSlug, personId])
}
