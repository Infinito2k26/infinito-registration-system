# Infinito 2K26 registration system: environment variables.
# Copy to .env for local development. In production, set these in the host's secret store.
# Never commit real values. "PROD:" notes are enforced at startup when NODE_ENV=production.

# --- Runtime -----------------------------------------------------------------
# development | production   (tests set "test" themselves)
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# Local: the docker-compose Postgres. PROD: your managed Postgres (e.g. Neon) URL.
DATABASE_URL="postgresql://postgres:infinito_dev_pwd@localhost:5433/infinito_dev"

# --- Public URL & secrets ----------------------------------------------------
# Every QR pass link and sign-in link is built from this. PROD: must be https://.
APP_BASE_URL="http://localhost:3000"
# Signs CSRF tokens. PROD: required, >= 32 chars:  openssl rand -hex 32
APP_SECRET=""
# Shared with the Apps Script (WEBHOOK_SECRET script property).
# PROD: random, >= 24 chars, not the placeholder:  openssl rand -hex 24
FORMS_WEBHOOK_SECRET="change-this-secret"

# --- Staff sign-in -----------------------------------------------------------
# Comma-separated; made active ADMINs on every start (and by `npx prisma db seed`).
BOOTSTRAP_ADMIN_EMAILS=""
SESSION_TTL_HOURS=168
MAGIC_LINK_TTL_MINUTES=15

# --- Email (Resend) ----------------------------------------------------------
# Empty RESEND_API_KEY in development = emails are printed to the server log, not sent.
# PROD: required. Switching accounts (dev -> official) is only a change of these values.
RESEND_API_KEY=""
# Resend -> Webhooks -> signing secret (whsec_...). Optional; enables delivered/bounced status.
RESEND_WEBHOOK_SECRET=""
# "Name <address>" on a domain verified in that Resend account. No default.
# Dev without a domain: "Infinito Dev <onboarding@resend.dev>" (delivers only to the account owner).
MAIL_FROM=""
# Monitored inbox for participant replies (plain address).
MAIL_REPLY_TO=""
# DEVELOPMENT ONLY: deliver every email to this inbox (real recipient shown in the subject).
# Ignored when NODE_ENV=production.
EMAIL_TEST_RECIPIENT=""
# Run the outbox sender in this process. Only ONE running instance per database should send.
EMAIL_WORKER_ENABLED=true
EMAIL_POLL_INTERVAL_MS=10000
# Pause between sends (Resend allows a few requests/second).
EMAIL_SEND_INTERVAL_MS=600
EMAIL_BATCH_SIZE=20
# Attempts for transient (5xx/network) failures before an email is marked FAILED.
EMAIL_MAX_ATTEMPTS=5
# 0 = no cap; otherwise max emails per rolling 24 h (useful while warming up a new domain).
EMAIL_DAILY_CAP=0

# --- Payments & QR passes ----------------------------------------------------
# Delay before QR / payment-issue emails send after a coordinator's decision (undo window).
DECISION_EMAIL_DELAY_SECONDS=120
# Manual "Resend QR email" clicks allowed per participant per event (the automatic first
# QR email is not counted). This is the QR resend limit.
QR_MANUAL_RESEND_LIMIT=3
# Random bytes per QR token (minimum 16). 32 -> 43-character token.
QR_TOKEN_BYTES=32

# Optional display names; otherwise derived from the slug ("table-tennis" -> "Table Tennis").
EVENT_NAMES='{}'

# --- Google Drive (participant photos / ID images) ---------------------------
# Service-account key JSON, raw or base64-encoded. Share the forms' upload folders with the
# service account's email as Viewer. Empty = photos/IDs are not shown (everything else works).
GOOGLE_SERVICE_ACCOUNT_JSON=""
