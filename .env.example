NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:infinito_dev_pwd@localhost:5433/infinito_dev"

# Public URL; QR codes and sign-in links point here. https:// enables secure cookies.
APP_BASE_URL="http://localhost:3000"
# Signs CSRF tokens. Required in production: openssl rand -hex 32
APP_SECRET=""

FORMS_WEBHOOK_SECRET="change-this-secret"

# Comma-separated; ensured as active admins on every start (first login).
BOOTSTRAP_ADMIN_EMAILS=""
SESSION_TTL_HOURS=168
MAGIC_LINK_TTL_MINUTES=15

# --- Email (Resend) -------------------------------------------------------
# Empty RESEND_API_KEY in development = emails are printed to the server log instead of sent.
# Swap these four for the official Infinito 2K26 account later; no code changes needed.
RESEND_API_KEY=""
# Resend -> Webhooks -> signing secret (whsec_...). Needed for delivery/bounce status.
RESEND_WEBHOOK_SECRET=""
# "Name <address>" on a domain verified in that Resend account
# (or "Infinito Dev <onboarding@resend.dev>", which can only deliver to the account owner's email).
MAIL_FROM=""
# Monitored inbox for participant replies.
MAIL_REPLY_TO=""
# Development only: deliver EVERY email to this address (real recipient shown in the subject).
EMAIL_TEST_RECIPIENT=""
EMAIL_WORKER_ENABLED=true
EMAIL_POLL_INTERVAL_MS=10000
EMAIL_SEND_INTERVAL_MS=600
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5
# 0 = no cap; otherwise max emails per rolling 24h (domain warm-up).
EMAIL_DAILY_CAP=0

# Undo window before QR / payment-issue emails are sent.
DECISION_EMAIL_DELAY_SECONDS=120
# Manual "Resend QR email" clicks per participant per event.
QR_MANUAL_RESEND_LIMIT=3
QR_TOKEN_BYTES=32

# Optional display names; otherwise derived from the slug ("table-tennis" -> "Table Tennis").
EVENT_NAMES='{}'

# Service account JSON (raw or base64) with Viewer access to the form upload folders.
GOOGLE_SERVICE_ACCOUNT_JSON=""
