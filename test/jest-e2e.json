{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/e2e-global-setup.ts",
  "setupFiles": [
    "<rootDir>/e2e-env.ts"
  ],
  "testTimeout": 30000
}
